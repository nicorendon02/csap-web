# ============================================================
#  CSAP — Colombian Student Association at Purdue
#  Apache Configuration for Hostinger
# ============================================================

# ── Enable Rewrite Engine ──────────────────────────────────
Options -Indexes
RewriteEngine On

# ── Force HTTPS ────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Remove www (optional — delete if you want www) ─────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── Clean URLs: /about → /about.html ──────────────────────
# Skip if the request is already a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Skip if it already has an extension (e.g. .css, .js, .php)
RewriteCond %{REQUEST_URI} !\.\w+$
# Serve the matching .html file transparently
RewriteRule ^([^/]+)/?$ $1.html [L]

# ── Remove .html from URLs typed with extension ────────────
# If someone visits /about.html, redirect to /about (canonical)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── Handle home page ──────────────────────────────────────
RewriteRule ^$ index.html [L]

# ── PHP Error Handling ─────────────────────────────────────
# Route PHP API calls (no rewrite — let PHP handle these)
RewriteRule ^php/ - [L]

# ── Custom Error Pages ─────────────────────────────────────
ErrorDocument 404 /404.html

# ── Security Headers ───────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Browser Caching ────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Gzip Compression ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
